// Prisma 7: the datasource URL lives in ../prisma.config.ts, not here.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth.js v5 core models (@auth/prisma-adapter contract — do not rename fields)
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?

  // Credentials provider (not part of the adapter contract)
  passwordHash      String?
  passwordUpdatedAt DateTime?

  firstName String?
  lastName  String?
  username  String? @unique

  role   Role       @default(MEMBER)
  status UserStatus @default(ACTIVE)

  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String?

  // The UI promises deletion "within 30 days", so this is a request flag
  // rather than an immediate DELETE.
  deletionRequestedAt DateTime?
  deletedAt           DateTime?

  /// Who created this user, when an admin adds one from the users table.
  invitedById String?
  invitedBy   User?   @relation("UserInvites", fields: [invitedById], references: [id], onDelete: SetNull)
  invitees    User[]  @relation("UserInvites")

  lastLoginAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts       Account[]
  sessions       Session[]

  preferences    UserPreferences?
  deviceSessions DeviceSession[]
  apiTokens      ApiToken[]
  auditLogs      AuditLog[]       @relation("AuditActor")
  auditTargets   AuditLog[]       @relation("AuditTargetUser")
  feedback       Feedback[]

  @@index([role])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@index([deletionRequestedAt])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
}

/// Required by the adapter's types. Stays EMPTY: the Credentials provider
/// forces `strategy: "jwt"`, so Auth.js never writes session rows.
/// The UI's session list is DeviceSession instead.
model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ---------------------------------------------------------------------------
// Access control
// ---------------------------------------------------------------------------

/// ADMIN   — full user management, including other admins
/// MANAGER — manage MEMBER and VIEWER users; cannot touch admins or managers
/// MEMBER  — own account only
/// VIEWER  — read-only; own account only
enum Role {
  ADMIN
  MANAGER
  MEMBER
  VIEWER
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

// ---------------------------------------------------------------------------
// Preferences
// ---------------------------------------------------------------------------

enum ThemeMode {
  LIGHT
  DARK
  SYSTEM
}

model UserPreferences {
  userId String @id

  theme ThemeMode @default(SYSTEM)

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Sessions surfaced in the UI (NOT the adapter's Session table)
// ---------------------------------------------------------------------------

/// `id` is the JWT `jti`, written in the signIn event. Revocation is enforced
/// in lib/auth/require-session.ts, the only place a protected request reads
/// the database.
model DeviceSession {
  id           String    @id
  userId       String
  deviceLabel  String
  deviceType   String
  userAgent    String?
  ipAddress    String?
  location     String?
  lastActiveAt DateTime  @default(now())
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Access tokens
// ---------------------------------------------------------------------------

/// The plaintext token is shown exactly once, at creation, and never stored —
/// only its sha256 hash plus a display preview.
model ApiToken {
  id         String    @id @default(cuid())
  userId     String
  name       String
  prefix     String
  last4      String
  tokenHash  String    @unique
  scopes     String[]  @default([])
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
}

// ---------------------------------------------------------------------------
// Audit log
// ---------------------------------------------------------------------------

model AuditLog {
  id      String  @id @default(cuid())
  actorId String?

  action     String
  actionCode String
  method     String?
  statusCode Int?

  /// The user this action was performed on, when it targets someone.
  targetUserId String?
  /// Denormalised so the row still reads correctly after the target is gone.
  targetLabel  String?

  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())

  actor      User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  targetUser User? @relation("AuditTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt(sort: Desc)])
  @@index([targetUserId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}

// ---------------------------------------------------------------------------
// App-wide settings
// ---------------------------------------------------------------------------

/// Singleton row (ROADMAP 6.1) — always read/written at id "singleton" via
/// upsert. No app-wide config table existed before this; a real second
/// setting should be added as a column here rather than a new table.
model AppSettings {
  id        String   @id @default("singleton")
  /// Public path under /uploads, e.g. "/uploads/<id>.png". Null renders the
  /// built-in AppLogo SVG fallback.
  logoUrl   String?
  updatedAt DateTime @updatedAt
}

/// Submitted from the header's Feedback button. No admin viewing UI yet —
/// intentional, to avoid rebuilding the "no admin panel exists" problem for
/// a first-cut feature; read via psql/Prisma Studio for now.
model Feedback {
  id        String   @id @default(cuid())
  userId    String?
  message   String
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
}
