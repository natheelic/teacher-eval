# Copy to .env and fill in. `.env` is gitignored; this file is the committed template.
#
#   cp .env.example .env
#
# Both Next.js and prisma.config.ts read `.env` (Prisma via `dotenv`).

# --- Database -------------------------------------------------------------
# Supabase (the primary setup). DATABASE_URL must then be left unset/commented.
# POSTGRES_PRISMA_URL is used for app queries (transaction pooler, 6543).
# POSTGRES_URL_NON_POOLING is used by Prisma CLI commands (session pooler, 5432).
# POSTGRES_URL is accepted as a fallback for app queries.
#
# Append BOTH of these to every POSTGRES_* URL:
#   uselibpqcompat=true  — gives sslmode=require its libpq meaning (encrypted,
#                          no CA check); without it node-postgres rejects the
#                          pooler with "self-signed certificate in certificate chain".
#   schema=portal        — all app tables live in their own Postgres schema. The
#                          shared database's `public` schema belongs to another
#                          application and must never be touched. lib/prisma.ts
#                          passes this value to the driver adapter explicitly.
# POSTGRES_PRISMA_URL="postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true&uselibpqcompat=true&schema=portal"
# POSTGRES_URL_NON_POOLING="postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require&uselibpqcompat=true&schema=portal"
# POSTGRES_URL="..."

# Local Docker Postgres alternative (`pnpm db:up`), matching docker-compose.yml.
# When set, DATABASE_URL overrides every POSTGRES_* URL above.
# DATABASE_URL="postgresql://portal:portal@localhost:5432/portal?schema=portal"

# Only needed for `prisma migrate diff --from-migrations` (AGENTS.md documents a
# schema-file diff that avoids it). `prisma migrate deploy` doesn't read this.
# A separate, disposable database:
# Prisma applies every migration to it to compute the diff, then drops it.
# docker exec -i portal-db psql -U portal -d postgres -c "CREATE DATABASE portal_shadow;"
# SHADOW_DATABASE_URL="postgresql://portal:portal@localhost:5432/portal_shadow?schema=public"

# --- Auth.js / NextAuth v5 ------------------------------------------------
# Generate one with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""

# The canonical origin of the app. Required whenever the app runs in
# production mode — including `pnpm start` on your own machine, which
# otherwise fails every auth request with `UntrustedHost`. Leave it unset for
# `pnpm dev` — Auth.js then infers the origin from the request.
# AUTH_URL="http://localhost:3000"

# --- Google OAuth ---------------------------------------------------------
# https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Email ------------------------------------------------------------------
# Optional, same as Google above: email-dependent features (invitations,
# verification, password resets) are only enabled once all three of
# SMTP_HOST/SMTP_PORT/SMTP_FROM are set.
#
# These are the BOOTSTRAP config — they apply on a fresh install and are
# superseded once an admin saves SMTP settings at /admin/email. Resolution is
# all-or-nothing on each side (database first, then these), in
# lib/email-config.ts; the two are never merged.
#
# `docker-compose.yml` runs Mailpit for local dev — no real mail account
# needed; sent mail is caught and viewable at http://localhost:8025.
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_FROM="Portal <noreply@portal.local>"
# SMTP_USER=""
# SMTP_PASS=""

# --- App ------------------------------------------------------------------
# Both are REQUIRED: they are validated in lib/env.ts so that a missing or
# misspelled name fails at boot rather than silently falling back to a default
# and rendering wrong project URLs across the dashboard.
#
# NEXT_PUBLIC_APP_NAME is now the FALLBACK display name and the TOTP issuer.
# The name actually shown across the app is editable at /admin/branding and
# stored in AppSettings.appName; this value applies until one is saved. The
# TOTP issuer deliberately stays on this build-time value — see
# lib/auth/totp.ts.
NEXT_PUBLIC_APP_NAME="Portal"
# A bare hostname, not a URL — used to build per-project URLs.
NEXT_PUBLIC_APP_DOMAIN="portal.local"
