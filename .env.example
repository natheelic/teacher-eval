# Copy to .env and fill in. `.env` is gitignored; this file is the committed template.
#
#   cp .env.example .env
#
# Both Next.js and prisma.config.ts read `.env` (Prisma via `dotenv`).

# --- Database -------------------------------------------------------------
# Matches the credentials in docker-compose.yml.
DATABASE_URL="postgresql://portal:portal@localhost:5432/portal?schema=public"

# --- Auth.js / NextAuth v5 ------------------------------------------------
# Generate one with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""

# The canonical origin of the app. Required in production. Leave it unset in
# development — Auth.js then infers the origin from the request, so the app
# still works if Next falls back to another port because 3000 is taken.
# AUTH_URL="https://portal.example.com"

# --- Google OAuth ---------------------------------------------------------
# https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- App ------------------------------------------------------------------
# Both are REQUIRED: they are validated in lib/env.ts so that a missing or
# misspelled name fails at boot rather than silently falling back to a default
# and rendering wrong project URLs across the dashboard.
NEXT_PUBLIC_APP_NAME="Portal"
# A bare hostname, not a URL — used to build per-project URLs.
NEXT_PUBLIC_APP_DOMAIN="portal.local"
